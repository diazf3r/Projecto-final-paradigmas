<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNAH DIPP</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header class="bg-white border-bottom sticky-top py-2 px-4">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <div class="unah-logo-badge">
                    <i class="bi bi-journal-bookmark-fill text-white"></i>
                </div>
                <div>
                    <span class="fw-bold text-dark d-block leading-none">UNAH</span>
                    <small class="text-muted text-uppercase" style="font-size: 0.65rem;">Dirección de Ingreso Permanencia y Promoción</small>
                </div>
            </a>

            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <button class="btn btn-user-profile dropdown-toggle d-flex align-items-center gap-2" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="~/images/avatar-placeholder.png" alt="Perfil" class="rounded-circle avatar-img" width="32" height="32">
                        <span class="fw-bold text-uppercase user-name-text">@User.Identity?.Name ?? "ESTUDIANTE"</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenu">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Mi Perfil</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Configuración</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                    </ul>
                </div>

                <div class="border-start ps-3 d-flex align-items-center gap-2">
                    <img src="~/images/unah-shield.png" alt="Escudo UNAH" height="28" class="opacity-75">
                    <button class="btn btn-light btn-sm rounded-circle" id="themeToggle" title="Cambiar Tema">
                        <i class="bi bi-moon"></i>
                    </button>
                </div>
            </div>

        </div>
    </header>

    <main role="main" class="flex-grow-1 container py-4">
        @RenderBody()
    </main>

    <footer class="footer-unah text-white pt-5 pb-3 mt-auto">
        <div class="container">
            <div class="row g-4">

                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-journal-bookmark-fill fs-4"></i>
                        <h5 class="fw-bold m-0">UNAH · DIPP</h5>
                    </div>

                    <p class="small text-white-50">
                        Dirección de Ingreso, Permanencia y Promoción — Universidad Nacional Autónoma de Honduras.
                    </p>

                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-envelope"></i></a>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="text-uppercase fw-bold text-white-50 mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">Accesos Rápidos</h6>
                    <ul class="list-unstyled small footer-links">
                        <li class="mb-2"><a href="#">Sistema de pregrado</a></li>
                        <li class="mb-2"><a href="#">Sistema de posgrado</a></li>
                        <li class="mb-2"><a href="#">Campus Virtual</a></li>
                        <li class="mb-2"><a href="#">Administración DIPP</a></li>
                        <li class="mb-2"><a href="#">Políticas de privacidad</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h6 class="text-uppercase fw-bold text-white-50 mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">Contacto</h6>
                    <ul class="list-unstyled small text-white-50">
                        <li class="mb-2 d-flex gap-2">
                            <i class="bi bi-geo-alt"></i>
                            <span>Ciudad Universitaria<br>Tegucigalpa, M.D.C. Honduras</span>
                        </li>
                        <li class="mb-2 d-flex gap-2">
                            <i class="bi bi-telephone"></i>
                            <div>
                                <span class="d-block text-white">ASESORÍA Y ATENCIÓN</span>
                                <a href="mailto:soportematriculadipp@unah.edu.hn" class="text-warning text-decoration-none">soportematriculadipp@unah.edu.hn</a><br>
                                <span>2216-3002</span>
                            </div>
                        </li>
                    </ul>
                </div>

            </div>

            <hr class="border-secondary my-4 opacity-25">
            <div class="d-flex justify-content-between align-items-center small text-white-50">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-bank"></i>
                    <span>UNAH</span>
                </div>
                <span>© @DateTime.Now.Year Universidad Nacional Autónoma de Honduras</span>
            </div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>